{
  "name": "giupay-backend",
  "version": "1.0.0",
  "description": "GiuPay DApp — Backend API + Bot + Smart Contracts",
  "main": "dist/src/server.js",
  "scripts": {
    "dev":            "ts-node-dev --respawn --transpile-only src/server.ts",
    "build":          "tsc --project tsconfig.json",
    "start":          "node dist/src/server.js",
    "bot":            "ts-node src/bot.ts",
    "bot:now":        "ts-node src/bot.ts --run-now",
    "indexer":        "ts-node src/indexer.ts",
    "indexer:once":   "ts-node src/indexer.ts --once",
    "cctp-relayer":       "ts-node src/cctp-relayer.ts",
    "cctp-relayer:once":  "ts-node src/cctp-relayer.ts --once",
    "compile":        "hardhat compile",
    "test:contracts": "hardhat test",
    "test:api":       "node --test test/api.test.mjs",
    "test:shipping":  "node --test test/shipping-api.test.mjs",
    "test:consistency": "node --test test/consistency.test.mjs",
    "test:tx":        "node --test test/tx-flow.test.mjs",
    "coverage":       "hardhat coverage",
    "deploy":         "hardhat run scripts/deploy.ts --network arc_testnet",
    "deploy:local":   "hardhat run scripts/deploy.ts --network hardhat",
    "node:local":     "hardhat node",
    "clean":          "hardhat clean",
    "seed":           "ts-node seed.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts":       "^5.0.2",
    "cors":                          "^2.8.5",
    "dotenv":                        "^16.4.5",
    "ethers":                        "^6.13.2",
    "express":                       "^4.19.2",
    "express-async-errors":          "^3.1.1",
    "express-oauth2-jwt-bearer":     "^1.6.0",
    "express-rate-limit":            "^7.3.1",
    "form-data":                     "^4.0.0",
    "helmet":                        "^7.1.0",
    "joi":                           "^17.13.1",
    "morgan":                        "^1.10.0",
    "multer":                        "^1.4.5-lts.1",
    "node-cron":                     "^3.0.3",
    "node-fetch":                    "^2.7.0",
    "nodemailer":                    "^6.9.14",
    "otplib":                        "^12.0.1",
    "pg":                            "^8.12.0",
    "qrcode":                        "^1.5.4"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/cors":                   "^2.8.17",
    "@types/express":                "^4.17.21",
    "@types/morgan":                 "^1.9.9",
    "@types/multer":                 "^1.4.11",
    "@types/node":                   "^20.14.9",
    "@types/node-cron":              "^3.0.11",
    "@types/node-fetch":             "^2.6.11",
    "@types/nodemailer":             "^6.4.15",
    "@types/pg":                     "^8.11.6",
    "@types/qrcode":                 "^1.5.5",
    "hardhat":                       "^2.22.5",
    "ts-node":                       "^10.9.2",
    "ts-node-dev":                   "^2.0.0",
    "typescript":                    "^5.5.3"
  }
}
